# Skopiuj do app/.env i uzupełnij po wdrożeniu raportu i agenta (skrypty w deploy\).
# Identyfikatory znajdziesz w .fabric\deployment.json albo w adresie elementu w portalu Fabric.
# VITE_NORTHWIND_WORKSPACE_ID jest opcjonalny, domyślnie aplikacja bierze workspace z konfiguracji Rayfin.
VITE_NORTHWIND_WORKSPACE_ID=
VITE_NORTHWIND_REPORT_ID=<REPORT_ID>
VITE_NORTHWIND_AGENT_ID=<DATA_AGENT_ID>
