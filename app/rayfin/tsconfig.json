{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": ".temp/compiled",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "rootDir": ".",
    "declaration": true,
    "composite": true,
    "module": "nodenext",
    "moduleResolution": "nodenext"
  },
  "include": [
    "**/*"
  ],
  "exclude": [
    ".temp/**/*"
  ]
}
